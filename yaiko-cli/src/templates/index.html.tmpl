<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="A modern fullstack application built with Yaiko">
    <title>Welcome to Yaiko</title>
    <link rel="stylesheet" href="/static/css/main.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app">
        <header class="header">
            <nav class="nav">
                <div class="nav__brand">
                    <span class="logo">⚡</span>
                    <span class="brand-name">Yaiko</span>
                </div>
                <ul class="nav__links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/api/users">API</a></li>
                    <li><a href="/health">Health</a></li>
                </ul>
            </nav>
        </header>
        
        <main class="main">
            <section class="hero">
                <div class="hero__content">
                    <h1 class="hero__title">Welcome to <span class="gradient-text">Yaiko</span></h1>
                    <p class="hero__subtitle">A modern, production-ready fullstack framework for Rust + jQuery</p>
                    <div class="hero__actions">
                        <button class="btn btn--primary" id="get-started">Get Started</button>
                        <a href="https://github.com/sazalo101/yaiko#readme" target="_blank" rel="noopener" class="btn btn--secondary" id="view-docs">Documentation ↗</a>
                    </div>
                </div>
                <div class="hero__visual">
                    <div class="code-block">
                        <pre><code>yaiko init my-app
cd my-app
yaiko dev</code></pre>
                    </div>
                </div>
            </section>
            
            <section class="features">
                <div class="feature-card glass">
                    <div class="feature-icon">🚀</div>
                    <h3>Fast</h3>
                    <p>Built on Rust for blazing fast performance</p>
                </div>
                <div class="feature-card glass">
                    <div class="feature-icon">🔒</div>
                    <h3>Secure</h3>
                    <p>CSRF, Rate Limiting, and Security Headers built-in</p>
                </div>
                <div class="feature-card glass">
                    <div class="feature-icon">📦</div>
                    <h3>Full Stack</h3>
                    <p>Rust backend + jQuery frontend, batteries included</p>
                </div>
            </section>
        </main>
        
        <footer class="footer">
            <p>&copy; 2026 Yaiko. Built with ❤️ and Rust.</p>
        </footer>
    </div>
    
    <div id="toast-container"></div>
    
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/static/js/core.js"></script>
    <script src="/static/js/app.js"></script>
</body>
</html>
